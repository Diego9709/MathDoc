# For a source checkout: copy to .env, then `set -a; . ./.env; set +a` before running the
# backend and `docker compose up` (compose.yaml). A Docker deployment uses mathdoc.env and
# secrets/ instead (docs: Docker deployment).
# Do not commit real tokens or passwords.

# Access tokens: each person or agent is an actor; admins create and delete databases.
MDC_ACTORS='{"alice":{"token":"replace-with-a-long-unique-token","admin":true},"bob":{"token":"replace-with-another-unique-token","admin":false}}'
MDC_HOST=127.0.0.1
MDC_PORT=17843
# Optional: an HTTP(S) origin accepted besides loopback, e.g. behind a reverse proxy.
# MDC_PUBLIC_ORIGIN=https://mathdoc.example.org

# Documents (TerminusDB) and collaboration data (PostgreSQL).
MDC_TERMINUS_URL=http://127.0.0.1:6363
MDC_TERMINUS_USER=admin
MDC_TERMINUS_PASSWORD=replace-me
MDC_DATABASE_URL=postgresql://mathdoc:replace-me@127.0.0.1:5432/mathdoc
# compose.yaml creates the PostgreSQL user with this password (compose.server.yaml generates
# its own in secrets/postgres-password).
MDC_POSTGRES_PASSWORD=replace-me

# LeanGround checks every Lean proof. The coordinator's service identity must be a
# fact token of that server (LeanGround docs/12).
LEANGROUND_SERVER_URL=http://127.0.0.1:8765
LEANGROUND_FACT_TOKEN=replace-with-coordinator-service-token
LEANGROUND_ACTOR=mathdoc-coordinator
# Optional: seconds a LeanGround call that runs Lean (resolve, submit, define, assemble)
# may take; default 960, just above LeanGround's own 900 s limit. Other calls wait 30 s.
# LEANGROUND_TIMEOUT_S=960

# The knowledge editor served at / and /p/<database>/<branch>/ (npm run build -w mdc-web).
MDC_WEB_DIR=web/dist
# Optional: Python with plasTeX 3.1 and pybtex 0.26.1 for LaTeX previews. Unset, the
# backend installs a pinned virtual environment under the cache on first use.
# MDC_LATEX_PYTHON=/path/to/python
# MDC_CACHE_DIR=/absolute/cache/path
